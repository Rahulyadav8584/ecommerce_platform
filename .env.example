# Environment configuration
APP_ENV=development
LOG_LEVEL=INFO

# Service URLs
STORE_API_URL=http://localhost:8001
SUB_AGENT_URL=http://localhost:8002
ORCHESTRATOR_URL=http://localhost:8000

# LLM Provider configuration: "fake" (default, no API key needed) | "openai" | "anthropic"
LLM_PROVIDER=fake
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Persistence: "sqlite" (default local) | "postgres"
CHECKPOINTER_TYPE=sqlite
DATABASE_URL=sqlite:///./chat_checkpoints.sqlite

